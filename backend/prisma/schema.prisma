generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int                @id @default(autoincrement())
  name         String
  email        String             @unique
  passwordHash String
  roleId       Int
  role         Role               @relation(fields: [roleId], references: [id])
  transactions StockTransaction[]
  auditLogs    AuditLog[]
  purchases    Purchase[]         @relation("PurchasesCreated")
}

model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique
  permissions String
  users       User[]
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  medicines   Medicine[]
}

model Medicine {
  id            Int            @id @default(autoincrement())
  genericName   String
  brandName     String
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id])
  manufacturer  String?
  dosageForm    String?
  barcode       String?        @unique
  active        Boolean        @default(true)
  reorderLevel  Int            @default(0)
  unit          String
  batches       Batch[]
  alerts        Alert[]
  purchaseItems PurchaseItem[]
}

model Supplier {
  id          Int        @id @default(autoincrement())
  name        String
  contactInfo String?
  batches     Batch[]
  purchases   Purchase[]
}

model Batch {
  id            Int                @id @default(autoincrement())
  medicineId    Int
  medicine      Medicine           @relation(fields: [medicineId], references: [id])
  supplierId    Int
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  batchNumber   String
  mfgDate       DateTime
  expiryDate    DateTime
  quantity      Int                @default(0)
  purchasePrice Decimal            @db.Decimal(12, 2)
  transactions  StockTransaction[]
  alerts        Alert[]
}

model Purchase {
  id          Int            @id @default(autoincrement())
  supplierId  Int
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  createdById Int
  createdBy   User           @relation("PurchasesCreated", fields: [createdById], references: [id])
  status      String         @default("DRAFT")
  notes       String?
  createdAt   DateTime       @default(now())
  receivedAt  DateTime?
  items       PurchaseItem[]
}

model PurchaseItem {
  id            Int      @id @default(autoincrement())
  purchaseId    Int
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicineId    Int
  medicine      Medicine @relation(fields: [medicineId], references: [id])
  batchNumber   String
  mfgDate       DateTime
  expiryDate    DateTime
  quantity      Int
  purchasePrice Decimal  @db.Decimal(12, 2)
}

model StockTransaction {
  id        Int      @id @default(autoincrement())
  batchId   Int
  batch     Batch    @relation(fields: [batchId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String // IN, OUT, ADJ
  quantity  Int
  timestamp DateTime @default(now())
  notes     String?
}

model Alert {
  id             Int       @id @default(autoincrement())
  fingerprint    String    @unique
  type           String
  severity       String
  status         String    @default("OPEN")
  message        String
  quantity       Int
  medicineId     Int
  medicine       Medicine  @relation(fields: [medicineId], references: [id])
  batchId        Int?
  batch          Batch?    @relation(fields: [batchId], references: [id])
  expiryDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  acknowledgedAt DateTime?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
