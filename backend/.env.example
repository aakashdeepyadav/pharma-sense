DATABASE_URL="postgresql://postgres:replace-me@localhost:5433/pharmasense?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
SEED_ADMIN_PASSWORD="replace-with-a-unique-development-password"
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173"
TRUST_PROXY_HOPS="0"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="40"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="10"
REQUIRE_PRIVILEGED_MFA="false"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a unique base64-encoded 32-byte key in production; never rotate it without re-enrolling MFA users.
MFA_ENCRYPTION_KEY="replace-with-a-generated-32-byte-base64-key"
